modules = ["python-3.11", "web", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
OPENAI_API_BASE_URL = "https://api.groq.com/openai/v1"
PORT = "5000"
HOST = "0.0.0.0"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'source .venv/bin/activate && PYTHONPATH=backend bash backend/start.sh'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
